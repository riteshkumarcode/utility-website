# Resend API Key for sending enquiry emails and customer receipts
RESEND_API_KEY=

# Inboxes
ENQUIRY_TO=info@westcoastservices.co.uk, sales@westcoastservices.co.uk
ENQUIRY_FROM="West Coast Services <enquiries@westcoastservices.co.uk>"

# Cloudflare Turnstile anti-spam keys
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics GA4 (optional, only loaded after cookie consent)
NEXT_PUBLIC_GA_ID=
